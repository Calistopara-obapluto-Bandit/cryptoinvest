<%- include('partials/head', { title: 'Contact Us — Clearwave Crypto', description: 'Get in touch with Clearwave: email, office address and a direct line to our investment representatives.' }) %>
<%- include('partials/nav', { active: 'contact' }) %>

  <main class="page-main">
    <%- include('partials/page-header', { title: 'Contact Us', crumb: 'Contact' }) %>

    <section class="container section-pad">
      <div class="contact-split">
        <div class="contact-copy">
          <h2 class="section-title">Get in touch <em>with us</em></h2>
          <p class="section-sub">Have questions about investments or need assistance? Our dedicated team is here to help you 24/7.</p>
          <div class="contact-detail">
            <span class="contact-detail-label">Email</span>
            <a href="mailto:contact@clearwavecrypto.com" class="contact-detail-value">contact@clearwavecrypto.com</a>
          </div>
          <div class="contact-detail">
            <span class="contact-detail-label">Address</span>
            <span class="contact-detail-value">109 Manly Street, Paraparaumu Beach<br />New Zealand</span>
          </div>
          <img class="contact-photo" src="/assets/images/site/company-1.jpg" width="960" height="640" loading="lazy" alt="The Clearwave office" />
        </div>

        <form class="contact-form" data-cw-form>
          <label class="form-field"><span>Name</span><input type="text" name="name" required /></label>
          <label class="form-field"><span>Email</span><input type="email" name="email" required /></label>
          <label class="form-field"><span>Phone</span><input type="tel" name="phone" /></label>
          <label class="form-field"><span>Message</span><textarea name="message" rows="5" required></textarea></label>
          <button class="btn-primary-lg" type="submit">Contact us now<span class="btn-arrow">→</span></button>
          <span class="form-status" data-form-status aria-live="polite"></span>
        </form>
      </div>
    </section>

    <%- include('partials/newsletter') %>
  </main>

<%- include('partials/footer') %>
