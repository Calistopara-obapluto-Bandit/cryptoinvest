<%
  // Deployed build self-report: this file is views/dashboard.ejs from the
  // current main. The running service logs the git commit it booted from at
  // startup (package.json._deployedCommit), so a Render log line like
  // "[deploy] booted commit: <hash>" can be tied back to this source.
  var member = Object.assign({
    full_name: 'Member',
    created_at: new Date().toISOString(),
    member_id: '',
    role: ''
  }, locals.member || {});
  var summary = Object.assign({
    accountBalance: 0, profitBalance: 0, bonusBalance: 0,
    ongoingInvestments: 0, ongoingCount: 0, approvedDeposits: 0,
    pendingDeposits: 0, completedInvestments: 0, completedInvestmentsCount: 0,
    completedWithdrawals: 0, pendingWithdrawals: 0, totalWithdrawal: 0,
    todayEarning: 0, referralBalance: 0, referrals: 0,
    earningThisMonth: 0, earningLastMonth: 0,
    earningHistory: []
  }, locals.summary || {});
  var plans = locals.plans || [];
  var estatePlans = locals.estatePlans || [];
  var transactions = locals.transactions || [];
  var activeInvestments = locals.activeInvestments || [];
  var referralLink = locals.referralLink || '';
  var title = locals.title || 'Your dashboard — Clearwave Crypto';
  var description = locals.description || 'Balances, transactions, referrals and investment packages in one place.';
  var active = locals.active || 'dashboard';
  var welcome = !!(locals.welcome === '1' || locals.welcome === true);
  var flash = locals.flash || {};
  if (!summary.earningHistory) summary.earningHistory = [];
  if (!activeInvestments || typeof activeInvestments !== 'object') activeInvestments = [];
  var firstName = member && member.full_name ? String(member.full_name).split(' ')[0] : 'Member';
  var joined = member && member.created_at ? new Date(member.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
  var isAdmin = member && member.role === 'admin';
  var shortDate = function (value) {
    return new Date(value).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  };
  var money = locals.money || function (value) {
    return '$' + Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  };
  var kindLabel = locals.kindLabel || function (kind) {
    return { deposit: 'Deposit', withdrawal: 'Withdrawal', investment: 'Investment', earning: 'Profit', bonus: 'Bonus' }[kind] || 'Entry';
  };
  var statusLabel = locals.statusLabel || function (status) {
    return { pending: 'Pending', approved: 'Approved', completed: 'Completed', rejected: 'Rejected' }[status] || String(status || '');
  };
  var methodLabel = locals.methodLabel || function (method) {
    return { bitcoin: 'Bitcoin', ethereum: 'Ethereum', usdt: 'USDT', bank: 'Bank transfer', standard: 'Managed package', estate: 'Real estate deal' }[method] || (method ? String(method) : '—');
  };
  var tiles = [
    { label: 'Account Balance',        value: summary.accountBalance,        icon: 'wallet' },
    { label: 'Profit Balance',         value: summary.profitBalance,         icon: 'chart' },
    { label: 'Bonus Balance',          value: summary.bonusBalance,          icon: 'gift' },
    { label: 'Ongoing Investments',    value: summary.ongoingInvestments,    icon: 'users' },
    { label: 'Approved Deposits',      value: summary.approvedDeposits,      icon: 'trophy' },
    { label: 'Pending Deposits',       value: summary.pendingDeposits,       icon: 'clock' },
    { label: 'Completed Investments',  value: summary.completedInvestments,  icon: 'check' },
    { label: 'Pending Withdrawals',    value: summary.pendingWithdrawals,    icon: 'clock' },
    { label: 'Completed Withdrawals',  value: summary.completedWithdrawals,  icon: 'check' },
    { label: "Today's Earning",        value: summary.todayEarning,          icon: 'tag' },
    { label: 'Referral Balance',       value: summary.referralBalance,       icon: 'users' },
    { label: 'Total Withdrawal',       value: summary.totalWithdrawal,       icon: 'out' }
  ];
  var packages = plans.concat(estatePlans);
  var maxBar = Math.max.apply(null, (summary.earningHistory || []).map(function (row) { return Number(row && row.total) || 0; }).concat([1]));
%>
<%- include('partials/head', { title: title, description: description }) %>
<%- include('partials/nav', { active: active }) %>

  <main class="app-main">
    <div class="container">
      <header class="app-head">
        <div class="app-head-copy">
          <div class="section-label">Member dashboard</div>
          <h1>Welcome back, <em><%= firstName %></em></h1>
          <p>Member ID <span class="mono"><%= (member && member.member_id) ? member.member_id : '' %></span> · with us since <%= joined %></p>
        </div>
        <div class="app-head-actions">
          <a href="/plan" class="btn-outline-lg">All packages<span>→</span></a>
        </div>
      </header>

      <% if (flash && flash.text) { %>
        <p class="form-notice form-notice--ok" role="status"><%= flash.text %></p>
      <% } %>

      <div class="app-actions">
        <a class="app-action app-action--deposit" href="/dashboard/deposit">
          <strong>Deposit</strong><span>Fund your balance</span>
        </a>
        <a class="app-action app-action--invest" href="/dashboard/invest">
          <strong>Invest</strong><span>Pick a package</span>
        </a>
        <a class="app-action app-action--withdraw" href="/dashboard/withdraw">
          <strong>Withdraw</strong><span>Cash out profits</span>
        </a>
      </div>

      <section class="tile-grid" aria-label="Account balances">
        <% (tiles || []).forEach(function (tile) { %>
          <article class="tile">
            <div class="tile-copy">
              <span class="tile-label"><%= (tile && tile.label) ? tile.label : '' %></span>
              <strong class="tile-value"><%= money(tile && tile.value != null ? tile.value : 0) %></strong>
            </div>
            <%- include('partials/tile-icon', { icon: (tile && tile.icon) ? tile.icon : 'wallet' }) %>
          </article>
        <% }); %>
      </section>

      <div class="app-cols">
        <section class="app-card app-card--wide">
          <header class="app-card-head">
            <h2>Most recent transactions</h2>
            <a href="/dashboard/transactions" class="app-card-link">View all</a>
          </header>
          <% if (!transactions || !transactions.length) { %>
            <p class="app-empty">No recent transactions found. Your first deposit will appear here.</p>
          <% } else { %>
            <div class="app-table-wrap">
              <table class="app-table">
                <thead>
                  <tr><th>ID</th><th>Type</th><th>Amount</th><th>Date</th></tr>
                </thead>
                <tbody>
                  <% (transactions || []).forEach(function (row) { %>
                    <tr>
                      <td><%= (row && row.reference) ? row.reference : '' %></td>
                      <td>
                        <%= (row && row.kind) ? kindLabel(row.kind) : '' %>
                        <span class="tx-status tx-status--<%= (row && row.status) ? row.status : '' %>"><%= (row && row.status) ? statusLabel(row.status) : '' %></span>
                      </td>
                      <td class="tx-amount<%= (row && (row.kind === 'withdrawal' || row.kind === 'investment')) ? ' is-out' : '' %>">
                        <%= (row && row.kind) ? ((row.kind === 'withdrawal' || row.kind === 'investment' ? '−' : '+') + money(row.amount)) : '' %>
                      </td>
                      <td><%= (row && row.created_at) ? shortDate(row.created_at) : '' %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>

        <section class="app-card">
          <h2>Referral link</h2>
          <p>Share this link. Every member who joins with it is credited to <span class="mono"><%= (member && member.member_id) ? member.member_id : '' %></span>.</p>
          <div class="app-ref">
            <input class="app-ref-input" type="text" readonly value="<%= (referralLink && referralLink.toString()) ? referralLink : '' %>" aria-label="Your referral link" />
            <button type="button" class="app-ref-copy" data-copy="<%= (referralLink && referralLink.toString()) ? referralLink : '' %>">Copy</button>
          </div>
          <p><%= (summary && summary.referrals != null ? summary.referrals : 0) %> member<%= (summary && summary.referrals != null ? summary.referrals : 0) === 1 ? '' : 's' %> joined with your link · balance <%= money(summary && summary.referralBalance != null ? summary.referralBalance : 0) %></p>
        </section>
      </div>

      <div class="app-cols">
        <section class="app-card app-card--wide">
          <header class="app-card-head">
            <h2>Your investments</h2>
            <a href="/dashboard/invest" class="app-card-link">New investment</a>
          </header>
          <% if (!activeInvestments || !activeInvestments.length) { %>
            <p class="app-empty">No investments yet. Fund your account, then choose a package — every package below is available to you.</p>
          <% } else { %>
            <ul class="inv-list">
              <% (activeInvestments || []).forEach(function (item) { %>
                <li class="inv-row">
                  <div class="inv-main">
                    <strong><%= (item && item.plan_name) ? item.plan_name : '' %></strong>
                    <span class="mono"><%= (item && item.reference) ? item.reference : '' %></span>
                  </div>
                  <div class="inv-fig">
                    <span>Invested</span>
                    <strong><%= money(item && item.amount != null ? item.amount : 0) %></strong>
                  </div>
                  <div class="inv-fig">
                    <span>Package ROI</span>
                    <strong><%= (item && item.roi_percent != null ? Number(item.roi_percent) : 0) %>%</strong>
                  </div>
                  <div class="inv-fig">
                    <span>Matures</span>
                    <strong><%= (item && item.matures_at) ? shortDate(item.matures_at) : '' %></strong>
                  </div>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </section>

        <section class="app-card">
          <h2>Earning overview</h2>
          <div class="earn-figures">
            <div><span>This month</span><strong><%= money(summary && summary.earningThisMonth != null ? summary.earningThisMonth : 0) %></strong></div>
            <div><span>Last month</span><strong><%= money(summary && summary.earningLastMonth != null ? summary.earningLastMonth : 0) %></strong></div>
          </div>
          <% if (summary && summary.earningHistory && summary.earningHistory.length) { %>
            <div class="earn-bars" aria-hidden="true">
              <% (summary.earningHistory || []).forEach(function (row) { %>
                <div class="earn-bar" title="<%= (row && row.month) ? row.month + ': ' + money(row.total) : '' %>">
                  <span style="height: <%= (row && row.total != null && maxBar && maxBar > 0) ? Math.max(6, Math.round((row.total / maxBar) * 100)) : 6 %>%"></span>
                  <em><%= (row && row.month) ? row.month.slice(5) : '' %></em>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="app-hint">Profit credits appear here as soon as a package pays out.</p>
          <% } %>
        </section>
      </div>

      <section class="app-card">
        <header class="app-card-head">
          <h2>What the site offers</h2>
          <a href="/dashboard/invest" class="app-card-link">Invest now</a>
        </header>
        <p>The same packages advertised on the plans page — pick one and the amount comes straight out of your balance.</p>
        <div class="pkg-grid">
          <% (packages || []).forEach(function (plan) { %>
            <article class="pkg-card<%= (plan && plan.featured) ? ' pkg-card--featured' : '' %>">
              <div class="pkg-head">
                <strong><%= (plan && plan.name) ? plan.name : 'Investment package' %></strong>
                <% if (plan && plan.featured) { %><span class="pkg-badge">Popular</span><% } %>
              </div>
              <p><%= (plan && plan.rateLabel) ? plan.rateLabel : '' %> <span><%= (plan && plan.kind === 'estate') ? 'ROI per month' : ((plan && plan.days) ? 'daily for ' + plan.days + ' days' : '') %></span></p>
              <dl class="pkg-rows">
                <div><dt>Minimum</dt><dd><%= (plan && plan.minLabel) ? plan.minLabel : '' %></dd></div>
                <div><dt>Maximum</dt><dd><%= (plan && plan.maxLabel) ? plan.maxLabel : '' %></dd></div>
                <div><dt>Term</dt><dd><%= (plan && plan.days) ? plan.days + ' days' : '' %></dd></div>
              </dl>
              <a class="pkg-cta" href="/dashboard/invest?plan=<%= (plan && plan.code) ? plan.code : '' %>">Invest in <%= (plan && plan.name) ? plan.name.split(' ')[0] : 'this package' %></a>
            </article>
          <% }); %>
        </div>
      </section>

      <% if (member && member.role === 'admin') { %>
        <div class="dash-admin-strip">
          <div>
            <strong>You are signed in as an administrator.</strong>
            <p>Pending deposits and withdrawals are waiting for approval in the admin dashboard.</p>
          </div>
          <a href="/admin" class="btn-primary">Open admin dashboard</a>
        </div>
      <% } %>
    </div>
  </main>

<%- include('partials/app-nav', { activeTab: 'dashboard' }) %>
<%- include('partials/footer') %>
