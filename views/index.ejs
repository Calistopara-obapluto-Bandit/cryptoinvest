    .nav-home .nav-logo span { color: var(--accent); }
    .nav-home .nav-links { display: flex; align-items: center; gap: 6px; }
    .nav-home .nav-links li { margin: 0; }
    .nav-home .nav-links a { font-size: 0.85rem; font-weight: 500; color: var(--text-2); padding: 6px 14px; border-radius: 100px; transition: color 0.3s, background 0.3s; display: block; }
