    @media (max-width: 820px) {
      .mobile-menu { display: flex; flex-direction: column; align-items: center; gap: 0; padding: 100px 32px 100px; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 998; background: var(--bg); opacity: 0; pointer-events: none; transition: opacity 0.4s var(--silk); }
      .mobile-menu.open { opacity: 1; pointer-events: all; }
      .mobile-menu a { font-size: 1.1rem; font-weight: 600; color: var(--text-1); padding: 14px 0; width: 100%; text-align: center; border-bottom: 1px solid var(--border); }
