      .mobile-menu .mobile-cta { margin-top: 28px; font-size: 0.9375rem; font-weight: 600; background: var(--accent); color: #fff; padding: 14px 40px; border-radius: 100px; }
      .mobile-menu .services-section { text-align: center; padding: 24px 0 8px; border-bottom: 1px solid var(--border); }
      .mobile-menu .services-section .section-label { margin: 0 0 12px; }
      .mobile-menu .services-section .section-title { font-size: 1.5rem; margin-bottom: 12px; }
      .mobile-menu .services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
