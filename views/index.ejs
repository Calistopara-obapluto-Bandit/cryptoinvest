    .nav-home .nav-hamburger { display: none; flex-direction: column; gap: 5px; width: 28px; padding: 4px; cursor: pointer; }
    .nav-home .nav-hamburger span { display: block; height: 2px; background: var(--text-1); border-radius: 2px; transition: all 0.4s var(--silk); }
    .nav-home .nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-home .nav-hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .nav-home .nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    /* ── Services dropdown panel ── */
