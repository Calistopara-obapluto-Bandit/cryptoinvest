    .services-dropdown .services-panel { display: none; position: absolute; top: 100%; left: 0; min-width: 240px; background: var(--surface-2); border: 1px solid var(--border); border-top: none; border-radius: 0 0 var(--radius) var(--radius); box-shadow: var(--shadow-lg); padding: 8px 0; z-index: 2000; }
