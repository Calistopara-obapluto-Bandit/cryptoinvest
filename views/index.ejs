  <!-- HOW IT WORKS -->
  <section class="features-section">
    <div class="container">
      <div class="features-header">
        <div class="section-label">4 Steps to Paper Trading</div>
        <h2 class="section-title">From zero to <em>live practice</em></h2>
        <p class="section-sub">No sign-up friction. Just pick a plan and start simulating.</p>
      </div>
      <figure class="how-figure">
        <img src="/assets/images/how-paper-trading-works.svg" width="1200" height="480" loading="lazy" alt="Diagram of the four Clearwave steps: pick a plan, fund a demo account with pretend cash, trade live BTC, ETH and SOL quotes, then review the trade ledger and repeat." />
        <figcaption>Every account runs the same loop: open a plan, fund it with demo cash, trade live quotes, then review the ledger before scaling up.</figcaption>
      </figure>
      <div class="step-list">
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-title">Pick a plan</div>
          <div class="step-desc">Choose Starter, Golden, Ultimate, or Premium — each unlocks different asset markets and balance caps.</div>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <div class="step-title">Fund your demo account</div>
          <div class="step-desc">Add between $100 and $100,000 of pretend cash. Top up or withdraw anytime from your dashboard.</div>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <div class="step-title">Trade live markets</div>
          <div class="step-desc">Buy and sell BTC, ETH, and SOL with live prices. Watch your ledger fill up with every order.</div>
        </div>
        <div class="step">
          <div class="step-num">4</div>
          <div class="step-title">Review and repeat</div>
          <div class="step-desc">Track pnl, read your trade journal, and scale up only when your strategy is proven.</div>
        </div>
      </div>
    </div>
  </section>

