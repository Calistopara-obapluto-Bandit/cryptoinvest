<%
  var standardPlans = [
    { name: 'Starter Plan',  rate: '1.5%', min: '$100',    max: '$4,999' },
    { name: 'Golden Plan',   rate: '2.5%', min: '$5,000',  max: '$99,999', featured: true },
    { name: 'Ultimate Plan', rate: '3.5%', min: '$10,000', max: '$19,999' },
    { name: 'Premium Plan',  rate: '4.5%', min: '$20,000', max: '$39,999' },
    { name: 'Index Plan',    rate: '5.5%', min: '$40,000', max: '$49,999' },
    { name: 'VIP Plan',      rate: '6.6%', min: '$50,000', max: 'Unlimited' }
  ];
  var estatePlans = [
    { name: 'The Skylight Manor',     rate: '22%', min: '$200,000', max: '$1,200,000', img: 'property-1.jpg' },
    { name: 'Cedarstone Residence',   rate: '18%', min: '$100,000', max: '$750,000',   img: 'property-2.jpg' },
    { name: 'The Haven at Montclair', rate: '15%', min: '$50,000',  max: '$500,000',   img: 'property-3.jpg' }
  ];
  var differentiators = [
    { title: 'An insurgent mindset', body: 'We work with ambitious clients who want to define the future, not hide from it. Together, we define a bold ambition and achieve extraordinary results that redefine industries.' },
    { title: 'Integrated innovation', body: 'We deliver integrated solutions, complementing our capabilities with a curated ecosystem of the world’s leading innovators to achieve better, faster, more enduring results for clients.' },
    { title: 'A uniquely collaborative culture', body: 'It feels different to work with us because our people are unlike any other. We bring a fresh perspective, mutual trust and infectious energy to every client relationship.' },
    { title: 'Practical', body: 'We combine bold thinking with a practical approach that focuses on getting the job done, turning decisions into action and delivering results.' },
    { title: 'One Team', body: 'We work as one global team — both with each other and our clients — to direct our collective energy toward achieving the extraordinary.' },
    { title: 'Passion & Commitment', body: 'We have a passion for results aligned with our clients’ success, and a commitment to the highest level of professionalism and ethical standards in everything we do.' }
  ];
  var steps = [
    { title: 'Registration', body: 'Register an account on our website to get a full package of services and work with cash flow.' },
    { title: 'Deposit', body: 'Open a deposit in one of the offered investment plans in your personal account using your prefered payment system.' },
    { title: 'Earn', body: 'Keep track of the profits in your personal account.' },
    { title: 'Withdraw', body: 'Once plan is completed you can withdraw profits to your wallet.' }
  ];
  var testimonials = [
    { quote: 'For me investing is about trust, ability, affinity and availability. I have been an investor with Clearwave since March and have found them to be competent individuals with integrity who pay attention to details and deliver for their clients.', name: 'Andre Cassidy', role: 'New Jersey', img: 'testimonial-1.png' },
    { quote: 'I am loving this platform so much, it is now my major way of earning money while I save. Please you should pay more attention to adverts, more people need to know about this.', name: 'Olivia Hawkins', role: 'Canada', img: 'testimonial-2.png' },
    { quote: 'I have never trusted any investment platform ever before, but this changed everything. They manage my assets, funds and everything in-between.', name: 'Belal Liam', role: 'New Zealand', img: 'testimonial-3.png' }
  ];
%>
<%- include('partials/head', { title: 'Clearwave Crypto — Investment Platform', description: 'Clearwave helps to grow your financial portfolio with commodities, cryptocurrency, real estate, staking and stock & ETFs investment plans.' }) %>
<%- include('partials/nav', { active: 'home' }) %>

  <main>
    <!-- BANNER -->
    <section class="hero">
      <div class="container">
        <div class="hero-inner">
          <div class="hero-content">
            <h1 class="hero-title">We help to grow your <em>financial portfolio</em></h1>
            <p class="hero-sub">As industry leaders, we pride ourselves on attracting and retaining the brightest minds in the business.</p>
            <div class="hero-actions">
              <a href="/contact" class="btn-primary-lg">Get Started<span class="btn-arrow">→</span></a>
              <a href="#platform" class="btn-outline-lg">See the platform<span>→</span></a>
            </div>
          </div>
          <div class="hero-visual">
            <figure class="hero-shot">
              <img src="/assets/images/site/hero-banner.jpg" width="1000" height="667" alt="Clearwave investment platform" />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- PLATFORM SHOWCASE -->
    <section class="showcase-section" id="platform">
      <div class="container">
        <div class="features-header">
          <h2 class="section-title">A look <em>inside the platform</em></h2>
          <p class="section-sub">The same site you are browsing — live market coverage, clear plan terms and a payout schedule you can follow.</p>
        </div>

        <figure class="showcase-frame">
          <div class="showcase-bar">
            <span class="showcase-dot"></span>
            <span class="showcase-dot"></span>
            <span class="showcase-dot"></span>
            <em>clearwavecrypto.com</em>
          </div>
          <div class="showcase-body" aria-hidden="true">
            <div class="sc-nav">
              <span class="sc-logo">Clear<span>wave</span></span>
              <span class="sc-links"><i>Home</i><i>Services</i><i>About</i><i>Plans</i><i>Contact</i></span>
              <span class="sc-cta">Get Started</span>
            </div>
            <div class="sc-hero">
              <div class="sc-copy">
                <span class="sc-badge">15K+ investors</span>
                <strong class="sc-title">We help to grow your financial portfolio</strong>
                <span class="sc-line"></span>
                <span class="sc-line sc-line--short"></span>
                <span class="sc-actions"><i class="sc-btn">Get Started</i><i class="sc-btn sc-btn--ghost">View Plans</i></span>
              </div>
              <div class="sc-chart">
                <span style="--h: 42%"></span>
                <span style="--h: 58%"></span>
                <span style="--h: 36%"></span>
                <span style="--h: 74%"></span>
                <span style="--h: 63%"></span>
                <span style="--h: 88%"></span>
                <span style="--h: 100%"></span>
              </div>
            </div>
            <div class="sc-plans">
              <div class="sc-plan"><span>Starter</span><strong>1.5%</strong></div>
              <div class="sc-plan"><span>Golden</span><strong>2.5%</strong></div>
              <div class="sc-plan"><span>VIP</span><strong>6.6%</strong></div>
            </div>
          </div>
          <figcaption class="showcase-caption">A preview of the Clearwave Crypto homepage.</figcaption>
        </figure>

        <div class="showcase-points">
          <div class="showcase-point">
            <h3>Secure Investment Platform</h3>
            <p>Learn about our advanced security measures and investment protection strategies.</p>
          </div>
          <div class="showcase-point">
            <h3>Expert Guidance</h3>
            <p>Our team of experts helps you pick a plan that matches your deposit and timeline.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="about-section">
      <div class="container">
        <div class="about-inner">
          <div class="about-media">
            <img class="about-photo" src="/assets/images/site/about-image.jpg" width="1000" height="630" loading="lazy" alt="Clearwave team" />
            <img class="about-accent" src="/assets/images/site/about-badge.png" width="60" height="69" alt="" aria-hidden="true" />
            <div class="about-stats">
              <div class="about-stat">
                <div class="about-stat-value">10</div>
                <div class="about-stat-label">Years + Experience</div>
              </div>
              <div class="about-stat">
                <div class="about-stat-value">15K</div>
                <div class="about-stat-label">Satisfied Customers</div>
              </div>
            </div>
          </div>
          <div class="about-copy">
            <div class="section-label">Learn More About our company</div>
            <h2 class="section-title">An income that exceeds <em>the most ambitious deposits</em></h2>
            <p class="section-sub">Clearwave offers its clients the opportunity to earn income that far exceeds even the most ambitious banking deposit offers. For investors, we provide a simple and convenient system for managing their investments: a wide selection of professional fund managers and capital management strategies, allowing everyone to choose comfortable ways to generate profits.</p>
            <p class="section-sub">Our company is all about creating innovative solutions and providing top-notch services to our clients. From start to finish, we’re dedicated to delivering results that exceed expectations.</p>
            <a href="/company" class="btn-outline-lg">Explore More <span>→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="features-section">
      <div class="container">
        <div class="benefit-split">
          <div class="benefit-intro">
            <div class="section-label">Benefits</div>
            <h2 class="section-title">We <em>offer</em></h2>
            <p class="section-sub">Our platform invests in a variety of assets, including securities of various industries, hedge funds and high-yield debt and money market instruments.</p>
            <div class="stat-tiles">
              <div class="stat-tile"><strong>25K</strong><span>Success rate</span></div>
              <div class="stat-tile"><strong>24/7</strong><span>Online service</span></div>
            </div>
          </div>
          <ul class="benefit-list">
            <li><span class="benefit-mark" aria-hidden="true">✓</span>Stay up to date with market trends and best practices in your industry.</li>
            <li><span class="benefit-mark" aria-hidden="true">✓</span>Get help from pros with diverse industry experience.</li>
            <li><span class="benefit-mark" aria-hidden="true">✓</span>Get personalized advice for your business needs.</li>
            <li><span class="benefit-mark" aria-hidden="true">✓</span>All transactions are free for all members.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- WHAT MAKES US DIFFERENT -->
    <section class="features-section">
      <div class="container">
        <div class="features-header">
          <div class="section-label">Why you should choose us</div>
          <h2 class="section-title">What makes us <em>different</em></h2>
        </div>
        <div class="diff-grid">
          <% differentiators.forEach(function (item, index) { %>
            <article class="diff-card">
              <div class="diff-num"><%= index + 1 %></div>
              <h3><%= item.title %></h3>
              <p><%= item.body %></p>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="pricing-section" id="plans">
      <div class="container">
        <div class="features-header">
          <div class="section-label">Investment Plans</div>
          <h2 class="section-title">Explore our diverse range of <em>investment plans</em></h2>
        </div>
        <%- include('partials/plan-grid', { standardPlans: standardPlans, estatePlans: estatePlans }) %>
      </div>
    </section>

    <!-- REPRESENTATIVES -->
    <section class="reps-section">
      <div class="container">
        <div class="features-header">
          <div class="section-label">Need Help?</div>
          <h2 class="section-title">Contact our <em>representatives</em></h2>
          <p class="section-sub">Have questions about investments or need assistance? Our dedicated team is here to help you 24/7.</p>
        </div>
        <div class="reps-grid">
          <article class="rep-card">
            <img class="rep-photo" src="/assets/images/site/company-1.jpg" width="640" height="480" loading="lazy" alt="Alexander, Clearwave representative" />
            <div class="rep-body">
              <div class="rep-name">Alexander</div>
              <div class="rep-role">Client Representative</div>
              <a href="/contact" class="rep-cta">Contact Alexander</a>
            </div>
          </article>
          <article class="rep-card">
            <img class="rep-photo" src="/assets/images/site/team-md.jpg" width="640" height="480" loading="lazy" alt="Kaiforc, Clearwave representative" />
            <div class="rep-body">
              <div class="rep-name">Kaiforc</div>
              <div class="rep-role">Investment Representative</div>
              <a href="/contact" class="rep-cta">Contact Kaiforc</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- CALCULATOR -->
    <section class="calc-section" id="calculator">
      <div class="container">
        <div class="features-header">
          <div class="section-label">Calculate profit</div>
          <h2 class="section-title">Choose your <em>plan</em></h2>
          <p class="section-sub">Estimate what a 30-day plan returns on your deposit. Figures are illustrative only.</p>
        </div>
        <form class="calc-form" data-cw-calc>
          <label class="calc-field">
            <span>Choose your plan</span>
            <select name="plan">
              <option value="1.5" selected>Starter — 1.5% daily</option>
              <option value="2.5">Golden — 2.5% daily</option>
              <option value="3.5">Ultimate — 3.5% daily</option>
              <option value="4.5">Premium — 4.5% daily</option>
              <option value="5.5">Index — 5.5% daily</option>
              <option value="6.6">VIP — 6.6% daily</option>
            </select>
          </label>
          <label class="calc-field">
            <span>Deposit Amount</span>
            <input type="number" name="deposit" min="100" step="100" value="1000" inputmode="numeric" />
          </label>
          <div class="calc-result">
            <span>Net Profit</span>
            <strong data-calc-profit>$450.00</strong>
          </div>
          <div class="calc-result">
            <span>Total Return</span>
            <strong data-calc-total>$1,450.00</strong>
          </div>
        </form>
      </div>
    </section>

    <!-- STEPS -->
    <section class="features-section">
      <div class="container">
        <div class="features-header">
          <div class="section-label">Simple steps to earn with us</div>
          <h2 class="section-title">Four steps to <em>your first payout</em></h2>
        </div>
        <div class="step-list">
          <% steps.forEach(function (step, index) { %>
            <div class="step">
              <div class="step-num"><%= index + 1 %></div>
              <div class="step-title"><%= step.title %></div>
              <div class="step-desc"><%= step.body %></div>
            </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="testimonials-section" id="testimonials">
      <div class="container">
        <div class="features-header">
          <div class="section-label">Our Clients Testimonials</div>
          <h2 class="section-title">Our clients are as diverse as <em>they are amazing</em></h2>
          <p class="section-sub">Ranging from individuals to established businesses.</p>
        </div>
        <div class="testimonials-grid">
          <% testimonials.forEach(function (item) { %>
            <div class="testimonial-card">
              <div class="quote-stars">★★★★★</div>
              <p class="quote"><%= item.quote %></p>
              <div class="author">
                <img class="avatar avatar-img" src="/assets/images/site/<%= item.img %>" width="121" height="121" alt="<%= item.name %>" loading="lazy" />
                <div><div class="author-name"><%= item.name %></div><div class="author-role"><%= item.role %></div></div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </section>

    <%- include('partials/newsletter') %>
  </main>

<%- include('partials/footer') %>
