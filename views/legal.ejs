<%- include('partials/head', { title: title, description: description }) %>
<%- include('partials/nav', { active: 'legal' }) %>

  <main class="page-main">
    <section class="container">
      <div class="page-head">
        <div class="section-label">Legal</div>
        <h1><%= heading %></h1>
        <p>Last updated November 2026. This document covers the Clearwave Crypto website and platform.</p>
      </div>
    </section>

    <section class="container">
      <div class="legal-prose">
        <% sections.forEach(function (section) { %>
          <h2><%= section.h %></h2>
          <p><%= section.p %></p>
        <% }); %>
      </div>

      <div class="related-row">
        <span class="related-label">Also read</span>
        <a class="related-chip" href="/privacy">Privacy Policy</a>
        <a class="related-chip" href="/terms">Terms of Service</a>
        <a class="related-chip" href="/contact">Contact the desk</a>
      </div>

      <div class="svc-cta">
        <a href="/plan" class="btn-cta-primary">Explore plans<span>→</span></a>
        <a href="/contact" class="btn-cta-ghost">Ask a rep</a>
      </div>
    </section>
  </main>

<%- include('partials/footer') %>
