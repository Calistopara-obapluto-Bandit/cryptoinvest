<%- include('partials/head', { title: title, description: description }) %>
<%- include('partials/nav', { active: active }) %>

  <main class="page-main">
    <section class="container section-pad">
      <div class="message-page">
        <div class="message-code"><%= status %></div>
        <h1 class="message-title"><%= heading %></h1>
        <p class="message-body"><%= body %></p>
        <% if (typeof errorId !== 'undefined' && errorId) { %>
          <p class="message-metadata">Error reference: <code><%= errorId %></code>
            <% if (typeof errorShort !== 'undefined' && errorShort) { %><span class="message-short"><%- errorShort %></span><% } %>
          </p>
        <% } %>
        <% if (locals && locals.retryUrl) { %>
          <a class="btn-ghost" href="<%= locals.retryUrl %>">Try again<span>→</span></a>
        <% } %>
        <div class="message-actions">
          <a href="/" class="btn-primary">Back to home</a>
          <a href="/contact" class="btn-outline-lg">Contact support<span>→</span></a>
        </div>
      </div>
    </section>
  </main>

<%- include('partials/footer') %>
