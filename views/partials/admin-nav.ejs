<%
  var tab = (typeof adminTab !== 'undefined' && adminTab) ? adminTab : 'overview';
  var items = [
    { key: 'overview', label: 'Overview', href: '/admin',            icon: 'home' },
    { key: 'cards',    label: 'Cards',    href: '/admin/cards',       icon: 'card' },
    { key: 'loans',    label: 'Loans',    href: '/admin/loans',       icon: 'loan' },
    { key: 'kyc',      label: 'KYC',      href: '/admin/kyc',         icon: 'kyc' },
    { key: 'members',  label: 'Members',  href: '/admin#members',     icon: 'users' }
  ];
%>
<nav class="app-nav app-nav--admin" aria-label="Admin shortcuts">
  <% items.forEach(function (item) { %>
    <a class="app-nav-item<%= tab === item.key ? ' is-active' : '' %>" href="<%= item.href %>"<%= tab === item.key ? ' aria-current="page"' : '' %>>
      <span class="app-nav-icon" aria-hidden="true">
        <% if (item.icon === 'home') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.4 12 3l9 7.4V21H3z"/><path d="M9.5 21v-6.4h5V21"/></svg>
        <% } else if (item.icon === 'card') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19"/><path d="M6 15h4"/></svg>
        <% } else if (item.icon === 'loan') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V7z"/><path d="M9 12h6"/><path d="M12 9v6"/></svg>
        <% } else if (item.icon === 'kyc') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><circle cx="8" cy="11" r="2.2"/><path d="M4.8 16.2c.4-1.6 1.7-2.5 3.2-2.5s2.8.9 3.2 2.5"/><path d="M15 10h4"/><path d="M15 13.5h4"/></svg>
        <% } else { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.4"/><path d="M2.8 20c.5-3.4 3.1-5.4 6.2-5.4s5.7 2 6.2 5.4"/><circle cx="17.5" cy="9.5" r="2.6"/><path d="M15.4 14.8c2.6.2 4.7 1.9 5.1 4.6"/></svg>
        <% } %>
      </span>
      <span class="app-nav-label"><%= item.label %></span>
    </a>
  <% }); %>
</nav>
