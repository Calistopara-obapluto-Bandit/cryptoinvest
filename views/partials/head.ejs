<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>
    // Apply the saved theme before first paint so dark mode never flashes light.
    (function () {
      try {
        var saved = localStorage.getItem('cw-theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (error) {
        // Storage blocked — fall back to the light theme.
      }
    })();
  </script>
  <meta name="description" content="<%= typeof description !== 'undefined' && description ? description : 'Clearwave Crypto — investment plans across commodities, cryptocurrency, real estate, staking and stock & ETFs.' %>" />
  <title><%= typeof title !== 'undefined' && title ? title : 'Clearwave Crypto — Investment Platform' %></title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%231A7A6E'/%3E%3Cpath d='M44 25a13 13 0 1 0 0 14' fill='none' stroke='white' stroke-width='6' stroke-linecap='round'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300&family=Playfair+Display:ital,wght@0,700;1,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/templatemo-622-clearwave.css" />
  <link rel="stylesheet" href="/clearwave.css" />
</head>
