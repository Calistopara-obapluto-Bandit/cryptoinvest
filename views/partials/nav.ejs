<%
  var page = (typeof active !== 'undefined' && active) ? active : '';
  var isServices = ['commodities', 'cryptocurrency', 'real-estate', 'staking', 'stocks'].indexOf(page) !== -1;
  var categories = [
    { slug: 'commodities',    title: 'Commodities & Gold', desc: 'Metals, energy and soft commodities' },
    { slug: 'cryptocurrency', title: 'Cryptocurrency',     desc: 'BTC, ETH, LTC and major pairs' },
    { slug: 'real-estate',    title: 'Real Estate',        desc: 'Residential and commercial deals' },
    { slug: 'staking',        title: 'Staking',            desc: 'Proof-of-stake rewards and lock-ups' },
    { slug: 'stocks',         title: 'Stock & ETFs',       desc: 'Equities, index and sector funds' }
  ];
%>
  <header class="nav" id="site-nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">Clearwave<span class="accent-light">Crypto</span></a>

      <ul class="nav-links" role="list">
        <li><a class="nav-link<%= page === 'home' ? ' is-active' : '' %>" href="/">Home</a></li>
        <li class="nav-item">
          <button type="button" class="nav-link<%= isServices ? ' is-active' : '' %>" aria-expanded="false" aria-controls="services-panel" aria-haspopup="true">
            Services
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="dropdown-panel" id="services-panel">
            <% categories.forEach(function (cat) { %>
              <a class="dropdown-item<%= page === cat.slug ? ' is-active' : '' %>" href="/<%= cat.slug %>">
                <span class="di-icon di-icon--img" aria-hidden="true"><img src="/assets/images/site/service-<%= categories.indexOf(cat) + 1 %>.png" width="56" height="56" alt="" loading="lazy" /></span>
                <span>
                  <span class="di-title"><%= cat.title %></span>
                  <span class="di-desc"><%= cat.desc %></span>
                </span>
              </a>
            <% }); %>
          </div>
        </li>
        <li><a class="nav-link<%= page === 'company' ? ' is-active' : '' %>" href="/company">About</a></li>
        <li><a class="nav-link<%= page === 'plan' ? ' is-active' : '' %>" href="/plan">Plan</a></li>
        <li><a class="nav-link<%= page === 'faq' ? ' is-active' : '' %>" href="/faq">FAQs</a></li>
        <li><a class="nav-link<%= page === 'contact' ? ' is-active' : '' %>" href="/contact">Contact Us</a></li>
      </ul>

      <div class="nav-cta">
        <a href="/contact" class="btn-primary">Get Started</a>
      </div>

      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to dark theme" title="Switch to dark theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.4"/><path d="M12 2v2.2M12 19.8V22M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2 12h2.2M19.8 12H22M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"/></svg>
      </button>

      <button class="nav-hamburger" id="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <div class="mobile-menu" id="mobile-menu">
    <div class="mm-label">Services</div>
    <div class="mm-links">
      <% categories.forEach(function (cat) { %>
        <a href="/<%= cat.slug %>"><%= cat.title %></a>
      <% }); %>
    </div>

    <div class="mm-label">Company</div>
    <div class="mm-links">
      <a href="/company">About Us</a>
      <a href="/plan">Plan</a>
      <a href="/faq">FAQs</a>
      <a href="/contact">Contact Us</a>
    </div>

    <a href="/contact" class="mm-cta">Get Started</a>
  </div>
