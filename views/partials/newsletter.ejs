  <section class="newsletter">
    <div class="newsletter-text">
      <div class="newsletter-title">Subscribe our newsletter</div>
      <div class="newsletter-sub">Hey! Are you tired of missing out on our updates? Subscribe to our news now and stay in the loop!</div>
    </div>
    <form class="newsletter-form" data-cw-form>
      <input class="newsletter-input" type="email" placeholder="Enter your email" aria-label="Email address" required />
      <button class="newsletter-btn" type="submit">Submit</button>
      <span data-form-status aria-live="polite"></span>
    </form>
  </section>
