<%
  var s = svc;
  var all = [
    { slug: 'commodities-gold', icon: '🪨', title: 'Commodities & Gold' },
    { slug: 'cryptocurrency',    icon: '₿',  title: 'Cryptocurrency' },
    { slug: 'real-estate',       icon: '🏠', title: 'Real Estate' },
    { slug: 'stock-etfs',        icon: '📊', title: 'Stock & ETFs' },
    { slug: 'loan',              icon: '🧾', title: 'Loan' },
    { slug: 'card',              icon: '💳', title: 'Card' },
    { slug: 'membership',        icon: '🎟️', title: 'Membership ID' },
    { slug: 'staking',           icon: '🌾', title: 'Staking' }
  ];
  var related = all.filter(function (item) { return item.slug !== s.slug; }).slice(0, 4);
%>
<%- include('head', { title: title, description: description }) %>
<%- include('nav', { active: 'services/' + s.slug }) %>

  <main class="page-main">
    <section class="container">
      <div class="svc-hero">
        <div class="svc-icon"><%= s.icon %></div>
        <h1><%= s.title %></h1>
        <p><%= s.lead %></p>
        <div class="btn-group">
          <a href="<%= s.primaryHref %>" class="btn-cta-primary"><%= s.primaryLabel %><span>→</span></a>
          <a href="/contact" class="btn-cta-ghost">Ask a rep</a>
        </div>
      </div>
    </section>

    <section class="container">
      <div class="svc-grid">
        <% s.cards.forEach(function (card) { %>
          <div class="svc-card">
            <div class="svc-card-icon"><%= card.icon %></div>
            <h3><%= card.title %></h3>
            <p><%= card.body %></p>
          </div>
        <% }); %>
      </div>

      <% (s.sections || []).forEach(function (section) { %>
        <div class="svc-section">
          <% if (section.label) { %><div class="svc-section-label"><%= section.label %></div><% } %>
          <h2 class="svc-section-title"><%= section.heading %></h2>
          <% section.paragraphs.forEach(function (paragraph) { %>
            <p class="svc-paragraph"><%= paragraph %></p>
          <% }); %>
        </div>
      <% }); %>

      <% if (s.benefits) { %>
        <div class="svc-section">
          <div class="svc-section-label">Benefits</div>
          <h2 class="svc-section-title"><%= s.benefits.heading %></h2>
          <div class="svc-benefits">
            <% s.benefits.items.forEach(function (item) { %>
              <div class="svc-benefit">
                <span class="svc-benefit-mark" aria-hidden="true">✓</span>
                <span><strong><%= item.title %></strong> — <%= item.body %></span>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <% if (s.steps) { %>
        <div class="svc-section">
          <div class="svc-section-label">How it works</div>
          <h2 class="svc-section-title"><%= s.steps.heading %></h2>
          <div class="svc-steps">
            <% s.steps.items.forEach(function (step, index) { %>
              <div class="svc-step">
                <div class="svc-step-num"><%= index + 1 %></div>
                <div class="svc-step-title"><%= step.title %></div>
                <% if (step.body) { %><div class="svc-step-body"><%= step.body %></div><% } %>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <% if (s.table) { %>
        <div class="svc-section">
          <% if (s.table.label) { %><div class="svc-section-label"><%= s.table.label %></div><% } %>
          <h2 class="svc-section-title"><%= s.table.heading %></h2>
          <div class="svc-table-wrap">
            <table class="svc-table">
              <thead>
                <tr>
                  <% s.table.columns.forEach(function (column) { %><th scope="col"><%= column %></th><% }); %>
                </tr>
              </thead>
              <tbody>
                <% s.table.rows.forEach(function (row) { %>
                  <tr>
                    <% row.forEach(function (cell, index) { %>
                      <% if (index === 0) { %><th scope="row"><%= cell %></th><% } else { %><td><%= cell %></td><% } %>
                    <% }); %>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% if (s.table.note) { %><p class="svc-table-note"><%= s.table.note %></p><% } %>
        </div>
      <% } %>

      <% if (s.faq) { %>
        <div class="svc-section">
          <div class="svc-section-label">F.A.Q</div>
          <h2 class="svc-section-title"><%= s.faq.heading %></h2>
          <div class="faq-list svc-faq">
            <% s.faq.items.forEach(function (item) { %>
              <div class="faq-item">
                <div class="faq-question" tabindex="0" role="button" aria-expanded="false"><%= item.q %><div class="faq-icon">+</div></div>
                <div class="faq-answer"><div class="faq-answer-inner"><%= item.a %></div></div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <% if (s.note) { %><div class="svc-note"><%= s.note %></div><% } %>

      <div class="related-row">
        <span class="related-label">Other markets</span>
        <% related.forEach(function (item) { %>
          <a class="related-chip" href="/services/<%= item.slug %>"><span aria-hidden="true"><%= item.icon %></span><%= item.title %></a>
        <% }); %>
        <a class="related-chip" href="/services">All services</a>
      </div>

      <div class="svc-cta">
        <a href="/contact" class="btn-cta-primary">Open a demo account<span>→</span></a>
        <a href="/services" class="btn-cta-ghost">Compare services</a>
      </div>
    </section>
  </main>

<%- include('footer') %>
