<span class="tile-icon" aria-hidden="true">
  <% if (icon === 'wallet') { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5H18a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3z"/><path d="M3 8.6h13.4"/><circle cx="17.4" cy="12.6" r="1.5"/></svg>
  <% } else if (icon === 'chart') { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5"/><path d="M4 19h16"/><path d="m7 15 4-4.6 3.4 2.9L20 7"/></svg>
  <% } else if (icon === 'gift') { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5h16V20H4z"/><path d="M3 7h18v3.5H3z"/><path d="M12 7v13"/><path d="M12 7S10.5 3.5 8.2 4.2 8.6 7 12 7zm0 0s1.5-3.5 3.8-2.8S15.4 7 12 7z"/></svg>
  <% } else if (icon === 'users') { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9.5" cy="8.5" r="3.3"/><path d="M3.5 20c.5-3.5 3-5.6 6-5.6s5.5 2.1 6 5.6"/><path d="M16 5.6a3 3 0 0 1 0 5.9"/><path d="M17.6 14.8c1.8.6 3 2.3 3.3 4.6"/></svg>
  <% } else if (icon === 'trophy') { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 4h9v5a4.5 4.5 0 0 1-9 0z"/><path d="M7.5 5.5H5a2 2 0 0 0 2.5 4"/><path d="M16.5 5.5H19a2 2 0 0 1-2.5 4"/><path d="M12 13.5V17"/><path d="M8.5 20h7"/><path d="M10 17h4l.6 3h-5.2z"/></svg>
  <% } else if (icon === 'clock') { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M12 7.6V12l3 1.9"/></svg>
  <% } else if (icon === 'check') { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="m8.2 12.2 2.6 2.7 5-5.6"/></svg>
  <% } else if (icon === 'tag') { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.6V4.4h8.2l7.4 7.4-8.2 8.2z"/><circle cx="8.4" cy="8.4" r="1.4"/></svg>
  <% } else { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 20V5h9l-1.6 3.4L15 12H6"/></svg>
  <% } %>
</span>
