<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= description %>" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300&family=Playfair+Display:ital,wght@0,700;1,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/templatemo-622-clearwave.css" />
  <style>
    .gmf-video { width: 100%; aspect-ratio: 16/9; border-radius: var(--radius); background: var(--accent); overflow: hidden; box-shadow: var(--shadow-lg); display: flex; align-items: center; justify-content: center; }
    .gmf-video img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .gmf-video .gmf-video-bg { position: absolute; inset: 0; background: var(--accent); opacity: 0.06; }
    .gmf-video .gmf-video-glow { position: absolute; inset: 0; background: repeating-linear-gradient(45deg, transparent, transparent 14px, rgba(26,122,110,0.05) 14px, rgba(26,122,110,0.05) 15px); pointer-events: none; }
    .gmf-video .gmf-video-glow2 { position: absolute; inset: 0; background: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(26,122,110,0.04) 10px, rgba(26,122,110,0.04) 11px); pointer-events: none; }
    .gmf-video-inner { position: relative; display: flex; align-items: center; justify-content: center; height: 100%; width: 100%; }
    .gmf-video-tag { position: absolute; top: 20px; left: 20px; background: rgba(255,255,255,0.12); color: #fff; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 6px 14px; border-radius: 100px; backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.2); }
    .gmf-video-play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .gmf-video-play svg { width: 56px; height: 56px; border-radius: 50%; background: rgba(255,255,255,0.18); border: 2px solid rgba(255,255,255,0.35); color: #fff; transition: background 0.4s var(--silk), border-color 0.4s var(--silk); }
    .gmf-video-play:hover svg { background: rgba(255,255,255,0.3); border-color: rgba(255,255,255,0.6); }

    /* Service dropdown panel */
    .services-panel { display: none; position: absolute; top: 100%; left: 0; min-width: 280px; background: #fff; border: 1px solid var(--border); border-top: none; border-radius: 0 0 var(--radius) var(--radius); box-shadow: var(--shadow-lg); padding: 12px 0; z-index: 100; }
    .services-panel a.panel-item { display: block; padding: 10px 24px; color: var(--text); text-decoration: none; font-size: 0.95rem; transition: background 0.2s var(--silk); }
    .services-panel a.panel-item:hover { background: var(--bg); padding-left: 32px; }
    .services-panel a.panel-item .panel-icon { margin-right: 10px; }
    .services-panel a.panel-item .panel-title { font-weight: 600; }
    .nav:hover .services-panel { display: block; }

    /* Category page scaffold */
    .svc-hero { background: linear-gradient(135deg, var(--accent) 0%, #1f4a40 60%, #14332e 100%); border-radius: var(--radius); padding: 80px 40px; color: #fff; text-align: center; }
    .svc-hero .svc-icon { font-size: 3rem; margin-bottom: 16px; }
    .svc-hero h1 { font-size: 2.2rem; font-weight: 700; margin: 0 0 12px 0; }
    .svc-hero p { font-size: 1.05rem; opacity: 0.9; max-width: 640px; margin: 0 auto 28px auto; }
    .svc-hero .btn-group { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .svc-hero .btn-group a { display: inline-block; }
    .svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 24px; padding: 40px 20px; }
    .svc-card { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow); transition: transform 0.2s var(--silk), box-shadow 0.2s var(--silk); }
    .svc-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
    .svc-card .svc-card-icon { font-size: 1.8rem; margin-bottom: 12px; }
    .svc-card h3 { font-size: 1.15rem; margin: 0 0 8px 0; }
    .svc-card p { color: var(--text-muted); font-size: 0.92rem; margin: 0; line-height: 1.55; }
    .svc-note { background: var(--bg); border-left: 4px solid var(--accent); padding: 18px 22px; border-radius: 0 var(--radius) var(--radius) 0; font-size: 0.92rem; color: var(--text-muted); margin: 28px 0; }
    .svc-cta { text-align: center; padding: 28px 0 32px 0; }
    .svc-cta .btn-cta-primary { padding: 14px 32px; font-size: 1rem; }
    .svc-cta .btn-cta-ghost { padding: 14px 32px; font-size: 1rem; }
    @media (max-width: 768px) {
      .svc-hero { padding: 56px 20px; }
      .svc-hero h1 { font-size: 1.6rem; }
      .services-panel { position: static; box-shadow: none; border: 1px solid var(--border); }
      .nav { position: relative; }
    }

    /* ── Responsive nav ── */
    @media (max-width: 820px) {
      .nav .nav-links { display: none; }
      .nav .nav-hamburger { display: flex; }
      .nav .nav-cta { display: none; }
      .nav .nav-cta-mobile { display: flex; }
      .nav .nav-hamburger + .nav-cta-mobile { display: none; }
      .services-panel { position: static; box-shadow: none; border: 1px solid var(--border); }
      .nav { position: relative; }
    }
  </style>
</head>
